version: '3.8'

services:
  # PostgreSQL Database
  db:
    image: postgres:15-bookworm
    container_name: volunteering_db
    environment:
      POSTGRES_DB: volunteering
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --lc-collate=C --lc-ctype=C"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backups:/backups
    ports:
      - "5432:5432"  # Для разработки
    restart: unless-stopped
    networks:
      - app-network

  # Redis Cache & Message Broker
  redis:
    image: redis:7-alpine
    container_name: volunteering_redis
    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"  # Для разработки
    restart: unless-stopped
    networks:
      - app-network

  # Django Backend Application
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile.simple
    container_name: volunteering_backend
    environment:
      - DATABASE_URL=postgres://postgres:postgres@db:5432/volunteering
      - REDIS_URL=redis://redis:6379/1
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
      - DJANGO_DEBUG=False
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-your-super-secret-production-key-change-this}
      - DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
      - CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
    volumes:
      - media_files:/app/media
      - static_files:/app/static
      - ./logs:/app/logs
    ports:
      - "8000:8000"  # Для разработки
    depends_on:
      - db
      - redis
    command: >
      sh -c "python manage.py migrate &&
             python manage.py collectstatic --noinput &&
             python manage.py shell -c 'from django.contrib.auth import get_user_model; User = get_user_model(); User.objects.create_superuser(\"admin\", \"admin@example.com\", \"admin123\") if not User.objects.filter(username=\"admin\").exists() else None' &&
             gunicorn --bind 0.0.0.0:8000 --workers 3 --worker-class sync --worker-tmp-dir /dev/shm --max-requests 1000 --max-requests-jitter 100 --timeout 30 --keep-alive 2 config.wsgi:application"
    restart: unless-stopped
    networks:
      - app-network

  # Celery Worker
  celery:
    build:
      context: ./backend
      dockerfile: Dockerfile.simple
    container_name: volunteering_celery
    environment:
      - DATABASE_URL=postgres://postgres:postgres@db:5432/volunteering
      - REDIS_URL=redis://redis:6379/1
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
      - DJANGO_DEBUG=False
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-your-super-secret-production-key-change-this}
      - DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
    volumes:
      - media_files:/app/media
      - static_files:/app/static
      - ./logs:/app/logs
    depends_on:
      - db
      - redis
    command: celery -A config worker -l info --concurrency=2
    restart: unless-stopped
    networks:
      - app-network

  # Celery Beat Scheduler
  celery-beat:
    build:
      context: ./backend
      dockerfile: Dockerfile.simple
    container_name: volunteering_celery_beat
    environment:
      - DATABASE_URL=postgres://postgres:postgres@db:5432/volunteering
      - REDIS_URL=redis://redis:6379/1
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
      - DJANGO_DEBUG=False
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-your-super-secret-production-key-change-this}
      - DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
    volumes:
      - media_files:/app/media
      - static_files:/app/static
      - ./logs:/app/logs
    depends_on:
      - db
      - redis
    command: celery -A config beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler
    restart: unless-stopped
    networks:
      - app-network

  # Vue.js Frontend Application
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: volunteering_frontend
    environment:
      - VITE_API_BASE_URL=/api
    restart: unless-stopped
    networks:
      - app-network

  # Nginx Reverse Proxy
  nginx:
    image: nginx:bookworm
    container_name: volunteering_nginx
    ports:
      - "80:80"
    depends_on:
      - backend
      - frontend
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - static_files:/var/www/static:ro
      - media_files:/var/www/media:ro
      - ./logs/nginx:/var/log/nginx
    restart: unless-stopped
    networks:
      - app-network

# Networks
networks:
  app-network:
    driver: bridge

# Volumes
volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
  media_files:
    driver: local
  static_files:
    driver: local
