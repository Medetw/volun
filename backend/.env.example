# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (Docker service name: db)
DATABASE_URL=postgres://postgres:postgres@db:5432/volunteering_platform

# Redis (Docker service name: redis)
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Email
DEFAULT_FROM_EMAIL=noreply@volunteer-platform.com
SITE_URL=http://localhost
