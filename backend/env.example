# Django Configuration
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-production-key-change-this
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Database Configuration (Docker network)
DATABASE_URL=postgres://postgres:postgres@db:5432/volunteering_platform_prod

# Redis Configuration (Docker network)
REDIS_URL=redis://redis:6379/1

# Celery Configuration (Docker network)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@volunteer-platform.com
SITE_URL=http://localhost

# CORS Configuration (Production)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Media Files
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/static

